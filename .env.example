# Copy this file to .env and fill in your Formspree form ID.
# Create a free form at https://formspree.io, then copy the ID from your
# form's endpoint (https://formspree.io/f/YOUR_FORM_ID).
# .env is already git-ignored — never commit real keys.

VITE_FORMSPREE_FORM_ID=

# URL of the Cloudflare Worker that powers the "ASK_HENA_AI" chat widget on the
# homepage (see PORTFOLIO_SETUP.md, section 7). Looks like
# https://ask-hena-ai.YOUR-SUBDOMAIN.workers.dev — leave blank to show a
# "not configured yet" notice in the widget instead of a broken chat.
VITE_AI_WORKER_URL=
